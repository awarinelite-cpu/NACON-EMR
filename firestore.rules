rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() { return request.auth != null; }
    function getRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isActive() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true; }
    function isAdmin()   { return isAuth() && isActive() && getRole() == 'admin'; }
    function isClinical(){ return isAuth() && isActive() && getRole() in ['doctor','nurse']; }
    function isRecords() { return isAuth() && isActive() && getRole() == 'records'; }
    function isAnyStaff(){ return isAuth() && isActive() && getRole() in ['doctor','nurse','records','admin','subadmin','pharmacist','lab']; }

    // EMR counter — only backend (transactions) can write
    match /counters/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isAnyStaff(); // protected by transaction logic
    }

    // Patients — records can create, all staff can read, clinical+records can update
    match /patients/{emrNumber} {
      allow read:   if isAnyStaff();
      allow create: if isRecords() || isAdmin();
      allow update: if isClinical() || isRecords() || isAdmin();
      allow delete: if isAdmin();
    }

    // Clinical data — doctor and nurse can write, all staff can read
    match /visits/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /notes/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /nursing_care_plans/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /vitals/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /prescriptions/{doc} {
      allow read:   if isAnyStaff();
      allow create: if isClinical() || isAdmin();
      // Pharmacist/subadmin need to update the dispensed/dispensedBy/dispensedAt
      // fields when they dispense a prescription from the Pharmacy dashboard.
      allow update: if isClinical() || isAdmin()
        || (isAuth() && isActive() && getRole() in ['pharmacist', 'subadmin']);
      allow delete: if isAdmin();
    }
    match /nhis_prescriptions/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /nacon_prescriptions/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /fluid_charts/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /glucose_charts/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /uploads/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin() || (isAuth() && isActive() && getRole() == 'lab');
    }
    match /referrals/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }

    // Users — admin only for write, self can read own doc
    match /users/{uid} {
      allow read:  if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Audit log — admin read only, all staff can write (append only)
    match /audit_log/{doc} {
      allow read:  if isAnyStaff();
      allow create: if isAnyStaff();
      allow update, delete: if false;
    }

    // Triage queue — clinical staff write, all staff read
    match /triage_queue/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }

    // Medication Administration Records — clinical write, all staff read
    match /mar_records/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }

    // Pharmacy inventory — admin/subadmin/pharmacist manage, all staff read
    match /pharmacy_inventory/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isAdmin()
        || (isAuth() && isActive() && getRole() in ['subadmin', 'pharmacist']);
    }

    // Self-reports (QR sick reports from students) — public create, staff read
    match /self_reports/{doc} {
      allow read:  if isAnyStaff();
      allow create: if true; // students submit without auth
      allow update: if isClinical() || isAdmin();
      allow delete: if isAdmin();
    }

    // sickReports subcollection under each patient
    match /patients/{emrNumber}/sickReports/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }

    // Pharmacy dispense log
    match /dispense_log/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isAuth() && isActive() && getRole() in ['pharmacist','admin','subadmin','doctor','nurse'];
    }

    // Laboratory requests
    match /lab_requests/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isAuth() && isActive() && getRole() in ['lab','doctor','nurse','admin','subadmin'];
    }

    // Laboratory results
    match /lab_results/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isAuth() && isActive() && getRole() in ['lab','admin','subadmin'];
    }

    // ── Telegram nursing-reminders bot ──
    // Medication / IV / glucose reminder queues — clinical staff create and
    // manage them from the app; the bot's webhook (Cloud Function, Admin SDK)
    // updates status server-side and bypasses these rules entirely.
    match /med_reminders/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /iv_infusions/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    match /glucose_schedule/{doc} {
      allow read:  if isAnyStaff();
      allow write: if isClinical() || isAdmin();
    }
    // Short-lived linking codes — a signed-in staff member can create one
    // for themselves; the bot webhook (Admin SDK) is what marks it used.
    match /link_codes/{code} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; // only the webhook (Admin SDK) marks these used
    }
    // Telegram <-> nurse link records — only the webhook (Admin SDK) writes
    // these; the owner can read their own to show "Linked" status, and may
    // delete it themselves to unlink from the app.
    match /telegram_links/{uid} {
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAuth() && request.auth.uid == uid;
      allow create, update: if false; // written by the webhook via Admin SDK
    }
  }
}
